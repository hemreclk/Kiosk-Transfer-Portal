@model CabinextKioskAktarim.Models.DashboardViewModel

@{
    ViewBag.Title = CabinextKioskAktarim.Services.Localization.Get("Dashboard");
}
@using CabinextKioskAktarim.Services

@section styles {
    <style>
        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-3);
        }
        .dashboard-header h1 {
            font-size: 28px;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 var(--spacing-1) 0;
        }
        .dashboard-header p {
            color: var(--text-helper);
            margin: 0;
        }
        .btn-upload {
            background-color: var(--brand-red);
            color: white;
            border: none;
            border-radius: var(--radius-md);
            padding: 10px 20px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: background-color 0.2s;
        }
        .btn-upload:hover {
            background-color: var(--error-red);
            color: white;
            text-decoration: none;
        }
        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: var(--spacing-3);
            margin-bottom: var(--spacing-3);
        }
        .summary-card {
            background: var(--bg-card);
            border: 1px solid var(--border-thin);
            border-radius: var(--radius-md);
            padding: var(--spacing-3);
            display: flex;
            flex-direction: column;
        }
        .summary-card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: var(--spacing-2);
        }
        .icon-box {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .icon-box.blue { background-color: #E6F0FF; color: var(--info-blue); }
        .icon-box.green { background-color: #E6F4EA; color: var(--success-green); }
        .icon-box.red { background-color: #FCE8E8; color: var(--error-red); }
        .icon-box.orange { background-color: #FEF0E6; color: var(--pending-orange); }
        .icon-box.pink { background-color: var(--brand-pink); color: var(--brand-red); }

        .summary-card-title {
            font-size: 14px;
            color: var(--text-helper);
            font-weight: 600;
        }
        .summary-card-value {
            font-size: 32px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 4px;
        }
        .summary-card-desc {
            font-size: 12px;
            color: var(--text-helper);
        }

        .dashboard-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: var(--spacing-3);
        }
        
        .panel {
            background: var(--bg-card);
            border: 1px solid var(--border-thin);
            border-radius: var(--radius-md);
            padding: var(--spacing-3);
        }
        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-3);
        }
        .panel-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
        }
        .table-custom {
            width: 100%;
            border-collapse: collapse;
        }
        .table-custom th {
            text-align: left;
            padding: 12px 8px;
            color: var(--text-helper);
            font-weight: 600;
            font-size: 13px;
            border-bottom: 1px solid var(--border-thin);
        }
        .table-custom td {
            padding: 16px 8px;
            border-bottom: 1px solid var(--border-thin);
            font-size: 14px;
            color: var(--text-main);
        }
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .status-success { background-color: #E6F4EA; color: var(--success-green); }
        .status-error { background-color: #FCE8E8; color: var(--error-red); }
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }
        .status-success .status-dot { background-color: var(--success-green); }
        .status-error .status-dot { background-color: var(--error-red); }

        .attention-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-thin);
        }
        .attention-item:last-child {
            border-bottom: none;
        }
        .attention-name {
            font-weight: 600;
            font-size: 14px;
        }
        .attention-reason {
            font-size: 13px;
            color: var(--text-helper);
        }
        
        .alert-box {
            background-color: #FCE8E8;
            border: 1px solid #F5C6C6;
            border-radius: var(--radius-md);
            padding: var(--spacing-2);
            display: flex;
            gap: 12px;
            margin-bottom: var(--spacing-3);
        }
        .alert-box h4 {
            color: var(--error-red);
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 4px 0;
        }
        .alert-box p {
            color: #9C1A1A;
            font-size: 13px;
            margin: 0;
        }

        @@media (max-width: 1024px) {
            .dashboard-content {
                grid-template-columns: 1fr;
            }
            .dashboard-header {
                flex-direction: column;
                align-items: flex-start;
                gap: var(--spacing-2);
            }
        }
    </style>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--error-red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <div>
            <h4>Veri Bağlantı Hatası</h4>
            <p>@Model.ErrorMessage</p>
        </div>
    </div>
}

@if (TempData["Hata"] != null)
{
    <div class="alert-box">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--error-red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <div>
            <h4>Yükleme Hatası</h4>
            <p>@TempData["Hata"]</p>
        </div>
    </div>
}

<div class="dashboard-header">
    <div>
        <h1>@Localization.Get("Welcome")</h1>
        <p>@Localization.Get("DashboardDesc")</p>
    </div>
    <form id="hizliYukleForm" action="@Url.Action("HizliYukle", "Kiosk")" method="post" enctype="multipart/form-data" style="margin:0;">
        @Html.AntiForgeryToken()
        <input type="file" name="dosya" id="hizliDosyaInput" accept=".csv" style="display:none;" onchange="document.getElementById('hizliYukleForm').submit();" />
        <button type="button" class="btn-upload" onclick="document.getElementById('hizliDosyaInput').click();">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            @Localization.Get("UploadCSV")
        </button>
    </form>
</div>

<div class="summary-cards">
    <div class="summary-card">
        <div class="summary-card-header">
            <div class="icon-box blue">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
            <div class="summary-card-title">@Localization.Get("TotalKiosk")</div>
        </div>
        <div class="summary-card-value">@Model.TotalKiosks</div>
    </div>
    <div class="summary-card">
        <div class="summary-card-header">
            <div class="icon-box green">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <div class="summary-card-title">@Localization.Get("SuccessKiosk")</div>
        </div>
        <div class="summary-card-value">@Model.ActiveKiosks</div>
    </div>
    <div class="summary-card">
        <div class="summary-card-header">
            <div class="icon-box red">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            </div>
            <div class="summary-card-title">@Localization.Get("ErrorKiosk")</div>
        </div>
        <div class="summary-card-value">@Model.PassiveKiosks</div>
    </div>

    <div class="summary-card">
        <div class="summary-card-header">
            <div class="icon-box pink">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="summary-card-title">@Localization.Get("Customers")</div>
        </div>
        <div class="summary-card-value">@Model.TotalCustomers</div>
    </div>
</div>

<div class="dashboard-content">
    <!-- Son Aktarılan Kiosklar -->
    <div class="panel">
        <div class="panel-header">
            <h2 class="panel-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                @Localization.Get("RecentKiosks")
            </h2>
            <a href="@Url.Action("Index", "Kiosk")" style="color: var(--brand-red); font-size: 13px; font-weight: 600; text-decoration: none;">@Html.Raw(Localization.Get("SeeAll"))</a>
        </div>
        
        <div style="overflow-x: auto;">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Localization.Get("KioskCode")</th>
                        <th>@Localization.Get("Barcode")</th>
                        <th>@Localization.Get("AddedDate")</th>
                        <th>@Localization.Get("Status")</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.RecentKiosks != null && Model.RecentKiosks.Count > 0)
                    {
                        int index = 1;
                        foreach(var k in Model.RecentKiosks)
                        {
                            <tr>
                                <td>@index</td>
                                <td style="font-weight: 600;">@k.Code</td>
                                <td>@(string.IsNullOrEmpty(k.Barcode) ? "-" : k.Barcode)</td>
                                <td>@(k.CreatedOn.HasValue ? k.CreatedOn.Value.ToString("dd MMM yyyy HH:mm") : "-")</td>
                                <td>
                                    @if(k.Active == 1)
                                    {
                                        <span class="status-badge status-success">
                                            <span class="status-dot"></span> Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-error">
                                            <span class="status-dot"></span> Pasif
                                        </span>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; color: var(--text-helper);">@Localization.Get("NoRecord")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Dikkat Gerektirenler -->
    <div class="panel">
        <div class="panel-header">
            <h2 class="panel-title" style="color: var(--error-red);">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                @Localization.Get("AttentionRequired")
            </h2>
        </div>
        
        @if(Model.AttentionRequiredKiosks != null && Model.AttentionRequiredKiosks.Count > 0)
        {
            <div class="alert-box">
                <div class="icon-box red" style="width: 32px; height: 32px; flex-shrink: 0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </div>
                <div>
                    <h4>@Localization.Get("RecentErrors")</h4>
                    <p>@Localization.Get("RecentErrorsDesc")</p>
                </div>
            </div>

            <div>
                @foreach(var k in Model.AttentionRequiredKiosks)
                {
                    <div class="attention-item">
                        <div style="flex: 1;">
                            <span class="attention-name">@k.KioskCode</span>
                            <span class="attention-reason" style="display:block;">@Localization.Get("Error"): @k.ErrorMessage</span>
                            <span class="attention-reason" style="font-size: 11px;">@Localization.Get("Customer"): @k.CustomerCode | @Localization.Get("Warehouse"): @k.WarehouseCode</span>
                        </div>
                        <div style="display:flex; gap: 8px;">
                            <a href="@Url.Action("Detay", "Kiosk", new { id = k.KioskCode })" style="background: none; border: none; color: var(--text-helper); padding: 4px;" title="Detay">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            </a>
                            <form action="@Url.Action("SilHatali", "Kiosk")" method="post" onsubmit="return confirm('Bu hatalı kaydı silmek istediğinize emin misiniz?');" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="kioskCode" value="@k.KioskCode" />
                                <button type="submit" style="background: none; border: none; color: var(--error-red); cursor: pointer; padding: 4px;" title="Sil">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
            
            <a href="@Url.Action("HataliKayitlar", "Kiosk")" class="btn-upload" style="background-color: #FCE8E8; color: var(--error-red); width: 100%; justify-content: center; margin-top: var(--spacing-3);">
                @Html.Raw(Localization.Get("ViewAll"))
            </a>
        }
        else
        {
            <div style="text-align: center; color: var(--success-green); padding: var(--spacing-3) 0;">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 12px; opacity: 0.5;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <p>@Localization.Get("NoAttention")</p>
            </div>
        }
    </div>
</div>