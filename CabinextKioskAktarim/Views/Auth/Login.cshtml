@model CabinextKioskAktarim.Models.LoginViewModel
@using CabinextKioskAktarim.Services

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@Localization.Get("LoginTitle")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css" />
    <style>
        :root {
            --brand-red: #EF3E4A; /* Algida benzeri kırmızı (veya pembe/kırmızı arası) */
            --brand-green: #20C997;
            --bg-color: #F0F4F8; /* Açık mavimsi arka plan */
            --text-dark: #1F2937;
            --text-muted: #6B7280;
            --error-bg: #FEE2E2;
            --error-text: #DC2626;
            --border-color: #D1D5DB;
        }

        body {
            background-color: var(--bg-color);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            position: relative;
            overflow: hidden;
            padding: 16px;
        }

        /* Arka Plan İllüstrasyonları */
        .bg-illustrations {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 1; /* Tasarımdaki gibi tam görünüm */
            background-image: url('/Content/Images/cabinext%20arka%20plan.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .login-card {
            background: #ffffff;
            width: 100%;
            max-width: 500px;
            padding: 48px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            text-align: center;
            position: relative;
            z-index: 10;
        }

        /* Logo ve Başlık Hiyerarşisi */
        .brand-logo-container {
            margin-bottom: 24px;
        }

        .brand-logo-container img {
            max-height: 80px;
            /* Eksik olan gerçek Cabinext logo dosyası buraya gelecek */
        }
        
        /* Gerçek logo yoksa görünecek yedek SVG */
        .fallback-logo {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: var(--brand-red);
            font-size: 36px;
            font-weight: 800;
            letter-spacing: -1px;
            justify-content: center;
        }

        .login-title {
            font-size: 26px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .login-subtitle {
            font-size: 15px;
            color: var(--text-muted);
            margin-bottom: 32px;
        }

        /* Hata Kutusu (Kartın İçinde) */
        .error-box {
            background-color: var(--error-bg);
            border: 1px solid #FCA5A5;
            border-radius: 8px;
            padding: 16px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            text-align: left;
            margin-bottom: 24px;
            position: relative;
        }
        .error-box svg {
            color: var(--error-text);
            flex-shrink: 0;
            margin-top: 2px;
        }
        .error-content {
            flex: 1;
        }
        .error-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--error-text);
            margin: 0 0 4px 0;
        }
        .error-desc {
            font-size: 13px;
            color: var(--error-text);
            margin: 0;
            opacity: 0.9;
        }
        .error-close {
            position: absolute;
            top: 16px;
            right: 16px;
            background: none;
            border: none;
            color: var(--error-text);
            cursor: pointer;
            padding: 0;
            line-height: 1;
        }

        /* Form Alanları */
        .input-group {
            position: relative;
            margin-bottom: 16px;
            width: 100%;
        }
        .input-group-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #9CA3AF;
        }
        .input-control {
            width: 100%;
            height: 52px;
            padding: 0 48px; /* Sağ ve sol ikonlar için yeterli boşluk */
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 15px;
            color: var(--text-dark);
            background-color: #fff;
            transition: all 0.2s;
            box-sizing: border-box;
        }
        .input-control:focus {
            outline: none;
            border-color: var(--brand-red);
            box-shadow: 0 0 0 3px rgba(239, 62, 74, 0.1);
        }
        
        .btn-eye {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #9CA3AF;
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Aksiyon Butonları */
        .action-buttons {
            display: flex;
            gap: 16px;
            margin-top: 24px;
            margin-bottom: 24px;
        }
        .btn-forgot, .btn-login {
            flex: 1;
            height: 52px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .btn-forgot {
            background-color: var(--brand-red);
            color: white;
        }
        .btn-login {
            background-color: var(--brand-green);
            color: white;
        }
        .btn-forgot:hover, .btn-login:hover {
            opacity: 0.9;
        }

        /* Yükleniyor Çubuğu */
        .loading-bar {
            background-color: #EFF6FF;
            color: #2563EB;
            border-radius: 8px;
            padding: 0;
            height: 52px;
            font-size: 15px;
            font-weight: 500;
            display: none;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 24px;
            margin-bottom: 24px;
        }
        .spinner {
            width: 20px;
            height: 20px;
            border: 2px solid #2563EB;
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @@keyframes spin { 100% { transform: rotate(360deg); } }

        /* Ayırıcı Çizgi */
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
            margin-bottom: 24px;
        }
        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--border-color);
        }
        .divider::before { margin-right: 16px; }
        .divider::after { margin-left: 16px; }

        /* Dil Seçimi Grid (4'lü Yatay Sıra) */
        .lang-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 40px;
        }
        .lang-btn {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-dark);
            cursor: pointer;
            transition: all 0.2s;
        }
        .lang-btn:hover {
            background-color: #F9FAFB;
        }
        .lang-btn.active {
            background-color: var(--brand-red);
            color: white;
            border-color: var(--brand-red);
        }
        a.lang-btn {
            text-decoration: none;
        }
        .lang-flag {
            font-size: 16px;
            line-height: 1;
        }
        
        @@media (max-width: 600px) {
            .lang-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .action-buttons {
                flex-direction: column;
            }
            .login-card {
                padding: 32px 24px;
            }
        }

        /* Alt Bilgi */
        .copyright {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0;
        }
    </style>
</head>
<body>

   
    <div class="bg-illustrations"></div>

    <div class="login-card">
        
        <div class="brand-logo-container">
            <img src="/Content/Images/cabinext%20logo.png" alt="Cabinext Logo" style="max-height: 50px; width: auto;" />
        </div>
        
        <h1 class="login-title">@Localization.Get("FormTitle")</h1>
        <p class="login-subtitle">@Localization.Get("FormSubtitle")</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-box" id="errorBox">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                <div class="error-content">
                    <h4 class="error-title">@Localization.Get("LoginErrorTitle")</h4>
                    <p class="error-desc">@Html.ValidationSummary(true, "")</p>
                </div>
                <button class="error-close" onclick="document.getElementById('errorBox').style.display='none'">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
        }

        <form action="@Url.Action("Login", "Auth")" method="post" id="loginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            
            <div class="input-group">
                <svg class="input-group-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <input type="text" name="Username" class="input-control" placeholder="@Localization.Get("Username")" value="@(Model?.Username ?? "")" required />
            </div>
            
            <div class="input-group">
                <svg class="input-group-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <input type="password" id="passwordInput" name="Password" class="input-control" placeholder="@Localization.Get("Password")" required />
                <button type="button" class="btn-eye" id="togglePassword">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
            </div>

            <div class="action-buttons" id="actionButtons">
                <button type="button" class="btn-forgot">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    @Localization.Get("ForgotPassword")
                </button>
                <button type="submit" class="btn-login" id="btnSubmit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    @Localization.Get("LoginButton")
                </button>
            </div>

            <div class="loading-bar" id="loadingBar">
                <div class="spinner"></div>
                @Localization.Get("Verifying")
            </div>
        </form>

        <div class="divider">@Localization.Get("LanguageSelection")</div>
        
        @{
            var currentLang = Request.Cookies["Language"]?.Value ?? "tr-TR";
        }
        
        <div class="lang-grid">
            <a href="@Url.Action("ChangeLanguage", "Auth", new { lang = "tr-TR", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @(currentLang == "tr-TR" ? "active" : "")">
                <span class="fi fi-tr"></span> Türkçe
            </a>
            <a href="@Url.Action("ChangeLanguage", "Auth", new { lang = "en-US", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @(currentLang == "en-US" ? "active" : "")">
                <span class="fi fi-gb"></span> English
            </a>
            <a href="@Url.Action("ChangeLanguage", "Auth", new { lang = "az-AZ", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @(currentLang == "az-AZ" ? "active" : "")">
                <span class="fi fi-az"></span> Azərbaycan
            </a>
            <a href="@Url.Action("ChangeLanguage", "Auth", new { lang = "ru-RU", returnUrl = Request.Url.PathAndQuery })" class="lang-btn @(currentLang == "ru-RU" ? "active" : "")">
                <span class="fi fi-ru"></span> Русский
            </a>
        </div>

        <p class="copyright">@Localization.Get("Copyright")</p>
    </div>

    <script>
        document.getElementById('togglePassword').addEventListener('click', function() {
            var input = document.getElementById('passwordInput');
            if (input.type === 'password') {
                input.type = 'text';
            } else {
                input.type = 'password';
            }
        });

        document.getElementById('loginForm').addEventListener('submit', function() {
            // Hata kutusu varsa gizle
            var errBox = document.getElementById('errorBox');
            if (errBox) errBox.style.display = 'none';

            // Butonları gizle, loading göster
            document.getElementById('actionButtons').style.display = 'none';
            document.getElementById('loadingBar').style.display = 'flex';
        });
    </script>
</body>
</html>
